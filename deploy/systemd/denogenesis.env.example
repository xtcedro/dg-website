# Optional overrides for denogenesis.service.
# Copy to /etc/denogenesis/denogenesis.env and edit; anything set here wins over
# the Environment= lines in the unit. Nothing in this file belongs in git.
#
#   sudo install -d -m 0755 /etc/denogenesis
#   sudo install -o root -g root -m 0640 deploy/systemd/denogenesis.env.example \
#     /etc/denogenesis/denogenesis.env
#
# deploy/deploy.sh installs this file from the example on first run and never
# overwrites it afterwards. Every variable is read by src/config.ts; a value it
# cannot parse (a non-numeric PORT, say) falls back to the default rather than
# stopping the service.

HOST=127.0.0.1
PORT=8004

# Deno KV database path, relative to the unit's WorkingDirectory (the checkout).
# It must stay inside data/ — that is the only directory the service can write.
KV_PATH=data/waitlist.db
