{
  "tasks": {
    "check": "deno check main.ts",
    "dev": "deno run --allow-net --allow-read=. --allow-write=data --allow-env=HOST,PORT,KV_PATH --watch main.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "start": "deno run --allow-net --allow-read=public,data --allow-write=data --allow-env=HOST,PORT,KV_PATH main.ts",
    "test": "deno test",
    "verify": "deno fmt --check && deno lint && deno check main.ts && deno test"
  },
  "unstable": ["kv"],
  "fmt": {
    "include": [
      "deno.json",
      "main.ts",
      "src/",
      "README.md",
      "AGENTS.md"
    ]
  },
  "lint": {
    "include": [
      "main.ts",
      "src/"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/http/file-server": "jsr:@std/http@^1.1.1/file-server",
    "@std/path": "jsr:@std/path@^1.0.0",
    "zod": "jsr:@zod/zod@^4.0.0"
  }
}
